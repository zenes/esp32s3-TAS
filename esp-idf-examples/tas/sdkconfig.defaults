# ESP32-S3 Hardware Optimization Defaults
# LilyGO T-ETH-Lite-S3 Specific Configurations

# 1. PSRAM (8MB Octal SPIRAM)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_TYPE_ESP32S3=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# 2. System Stability (Stack Sizes)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=7168
CONFIG_ARDUINO_LOOP_STACK_SIZE=16384

# 3. Network Features (NAPT / Internet Sharing)
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y

# 4. Other Optimizations
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=160
